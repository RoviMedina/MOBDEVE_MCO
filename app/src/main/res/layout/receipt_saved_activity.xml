<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- TODO: Create ReceiptSavedActivity.kt or use this as a success state after database save. -->
    <TextView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:background="@color/success"
        android:gravity="center"
        android:text="OK"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Receipt Saved"
        android:textColor="@color/textPrimary"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Your expense has been added to history."
        android:textColor="@color/textSecondary"
        android:textSize="15sp" />

    <!-- TODO: Wire these buttons to ExpenseHistoryActivity and ScanReceiptActivity. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnViewSavedReceipt"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="32dp"
        android:text="View in History"
        android:textAllCaps="false"
        app:cornerRadius="18dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnScanAnotherReceipt"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:text="Scan Another"
        android:textAllCaps="false"
        app:cornerRadius="18dp" />
</LinearLayout>
