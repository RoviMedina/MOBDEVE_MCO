<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Receipt Details"
            android:textColor="@color/textPrimary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- TODO: Display the captured receipt image once camera/gallery support is implemented. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="198dp"
            android:layout_marginBottom="16dp"
            android:background="#EEEEEE"
            android:gravity="center"
            android:text="Receipt Image Placeholder"
            android:textSize="18sp" />

        <!-- TODO: Load the selected receipt details by receipt id instead of hardcoded sample data. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Store: Jollibee"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Date: June 27, 2026"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Category: Food"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Total: &#8369;250.00"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Items"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="#EEEEEE"
            android:padding="12dp"
            android:text="Chickenjoy - &#8369;120.00\nBurger Steak - &#8369;100.00\nDrink - &#8369;30.00" />

        <Button
            android:id="@+id/btnEditReceipt"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp"
            android:text="@string/edit_receipt"
            app:cornerRadius="16dp" />

        <Button
            android:id="@+id/btnDeleteReceipt"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/delete_receipt"
            android:textColor="@color/danger"
            app:backgroundTint="@color/white"
            app:cornerRadius="16dp"
            app:strokeColor="@color/danger" />
    </LinearLayout>
</ScrollView>
