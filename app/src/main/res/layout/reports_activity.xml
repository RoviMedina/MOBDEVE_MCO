<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Expense Reports"
            android:textColor="@color/textPrimary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- TODO: Replace placeholder with MPAndroidChart or another approved chart library. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginBottom="16dp"
            android:background="#EEEEEE"
            android:gravity="center"
            android:text="Pie Chart Placeholder\nExpenses by Category"
            android:textSize="18sp" />

        <!-- TODO: Compute totals from saved receipts grouped by selected month. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="#EEEEEE"
            android:padding="16dp"
            android:text="Total This Month\n&#8369;4,250.00"
            android:textSize="20sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="#EEEEEE"
            android:padding="16dp"
            android:text="Highest Category\nFood"
            android:textSize="20sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:background="#EEEEEE"
            android:gravity="center"
            android:text="Bar Chart Placeholder\nMonthly Spending"
            android:textSize="18sp" />
    </LinearLayout>
</ScrollView>
